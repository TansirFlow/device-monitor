# 行尾约定。本机 core.autocrlf=true，若不显式声明，Windows 上检出的 shell 脚本
# 会变成 CRLF，运行时直接报 `/bin/sh^M: bad interpreter`。
# 因此所有类 Unix 文本一律固定 LF，只有 PowerShell 反过来需要 CRLF。

* text=auto

# 类 Unix 脚本与配置：必须 LF
*.sh         text eol=lf
*.service    text eol=lf
*.conf       text eol=lf
*.example    text eol=lf
*.mjs        text eol=lf
*.go         text eol=lf
*.mod        text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
Makefile     text eol=lf
Dockerfile*  text eol=lf

# PowerShell：PS 5.1 靠 BOM 识别 UTF-8（BOM 是文件内容，不受此影响），
# 行尾则需要 CRLF。
*.ps1        text eol=crlf

# 二进制，绝不参与换行转换
*.png binary
*.exe binary
